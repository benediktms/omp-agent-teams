{
  "name": "@benediktms/omp-agent-teams",
  "version": "0.5.7",
  "description": "Claude Code agent teams style workflow for Oh My Pi.",
  "license": "MIT",
  "author": "Thomas Mustier",
  "private": false,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benediktms/omp-agent-teams.git"
  },
  "bugs": "https://github.com/benediktms/omp-agent-teams/issues",
  "homepage": "https://github.com/benediktms/omp-agent-teams",
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "lint": "bun run --bun eslint 'extensions/**/*.ts' 'scripts/**/*.ts' 'scripts/**/*.mts'",
    "typecheck": "bun run --bun tsc -p tsconfig.strict.json",
    "check": "bun run typecheck && bun run lint",
    "test:rpc": "bun scripts/teammate-rpc-test.mts",
    "smoke-test": "bun scripts/smoke-test.mts",
    "integration-claim-test": "bun scripts/integration-claim-test.mts",
    "integration-spawn-overrides-test": "bun scripts/integration-spawn-overrides-test.mts",
    "integration-hooks-remediation-test": "bun scripts/integration-hooks-remediation-test.mts",
    "integration-todo-test": "bun scripts/integration-todo-test.mts",
    "integration-cleanup-test": "bun scripts/integration-cleanup-test.mts",
    "integration-branch-context-test": "bun scripts/integration-branch-context-test.mts"
  },
  "dependencies": {
    "@oh-my-pi/pi-coding-agent": "18.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@earendil-works/pi-agent-core": "^0.74.0",
    "@earendil-works/pi-ai": "^0.74.0",
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@earendil-works/pi-tui": "^0.74.0",
    "@sinclair/typebox": "^0.34.48",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@sinclair/typebox": "*"
  }
}
